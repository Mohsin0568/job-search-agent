# Copy to .env.local and fill in values from the Cognito console (User Pool -> App integration).
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Leave empty in development: requests to /api are proxied to localhost:8080 by Vite.
VITE_API_BASE_URL=

# Shows the "invite-only for now" note on the register page. Set to false alongside the backend's
# INVITE_ONLY=false when the app opens to everyone.
VITE_INVITE_ONLY=true
